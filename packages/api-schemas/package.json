    "./team": "./src/team.ts",
    "./user": "./src/user.ts",
    "./billing": "./src/billing.ts",
    "./common": "./src/common.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.19.8",
    "zod": "3.25.64",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
