{
  "name": "@midday/api-schemas",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "biome check .",
