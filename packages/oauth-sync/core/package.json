{
  "name": "@midday/oauth-sync-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime-agnostic OAuth token synchronization core library",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs"
    },
    "./storage": {
      "import": "./dist/storage/index.js",
      "require": "./dist/storage/index.cjs"
    },
    "./utils/events": {
      "import": "./dist/utils/events.js",
      "require": "./dist/utils/events.cjs"
    },
    "./utils/retry": {
      "import": "./dist/utils/retry.js",
      "require": "./dist/utils/retry.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2.0.0",
    "drizzle-orm": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@midday/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.2"
  }
}
