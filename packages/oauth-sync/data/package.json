{
  "name": "@midday/oauth-sync-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Data synchronization layer for OAuth providers with automatic token refresh",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./strategies": {
      "import": "./dist/strategies/index.mjs",
      "require": "./dist/strategies/index.js",
      "types": "./dist/strategies/index.d.ts"
    },
    "./database": {
      "import": "./dist/database/index.mjs",
      "require": "./dist/database/index.js",
      "types": "./dist/database/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@midday/oauth-sync-core": "workspace:*",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2.0.0",
    "drizzle-orm": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@midday/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.2"
  }
}
