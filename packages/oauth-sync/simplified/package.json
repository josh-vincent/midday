{
  "name": "@midday/oauth-sync",
  "version": "0.1.0",
  "description": "Simplified OAuth token synchronization with automatic refresh and data sync",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/oauth-sync.js",
      "types": "./dist/oauth-sync.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas.js",
      "types": "./dist/schemas.d.ts"
    },
    "./providers": {
      "import": "./dist/providers.js",
      "types": "./dist/providers.d.ts"
    },
    "./presets": {
      "import": "./dist/presets/index.js",
      "types": "./dist/presets/index.d.ts"
    },
    "./runtimes/trigger": {
      "import": "./dist/runtimes/trigger.js",
      "types": "./dist/runtimes/trigger.d.ts"
    },
    "./runtimes/cloudflare": {
      "import": "./dist/runtimes/cloudflare.js",
      "types": "./dist/runtimes/cloudflare.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midday/oauth-sync-core": "workspace:*",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "typescript": "^5.7.2"
  }
}
