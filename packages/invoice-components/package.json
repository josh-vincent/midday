{
  "name": "@midday/invoice-components",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sheet": {
      "types": "./src/components/sheet/index.ts",
      "import": "./src/components/sheet/index.ts",
      "default": "./src/components/sheet/index.ts"
    },
    "./form": {
      "types": "./src/components/form/index.ts",
      "import": "./src/components/form/index.ts",
      "default": "./src/components/form/index.ts"
    },
    "./form/*": {
      "types": "./src/components/form/*.tsx",
      "import": "./src/components/form/*.tsx",
      "default": "./src/components/form/*.tsx"
    },
    "./preview": {
      "types": "./src/components/invoice-preview.tsx",
      "import": "./src/components/invoice-preview.tsx",
      "default": "./src/components/invoice-preview.tsx"
    },
    "./actions": {
      "types": "./src/components/invoice-actions.tsx",
      "import": "./src/components/invoice-actions.tsx",
      "default": "./src/components/invoice-actions.tsx"
    },
    "./share": {
      "types": "./src/components/invoice-share-dialog.tsx",
      "import": "./src/components/invoice-share-dialog.tsx",
      "default": "./src/components/invoice-share-dialog.tsx"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "import": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./pdf": {
      "types": "./src/utils/generate-pdf.ts",
      "import": "./src/utils/generate-pdf.ts",
      "default": "./src/utils/generate-pdf.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    }
  },
  "dependencies": {
    "@midday/ui": "workspace:*",
    "@midday/invoice-core": "workspace:*",
    "@midday/overlay-components": "workspace:*",
    "@react-pdf/renderer": "^4.3.0",
    "@tanstack/react-query": "^5.64.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.55.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "date-fns": "^4.1.0",
    "usehooks-ts": "^3.1.0",
    "nanoid": "^5.0.9",
    "nuqs": "^2.2.4",
    "@number-flow/react": "^0.5.10"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}