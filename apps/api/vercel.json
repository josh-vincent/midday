{
  "version": 2,
  "public": false,
  "buildCommand": "echo 'Skipping build - Vercel will build automatically'",
  "installCommand": "bun install",
  "framework": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "build": {
    "env": {
      "SKIP_ENV_VALIDATION": "true"
    }
  }
}
