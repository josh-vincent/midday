# OAuth Sync v3 Configuration
# All variables are auto-detected by OAuth Sync v3 - zero configuration required!

# =============================================================================
# Storage (Auto-detected - choose one)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
# OR
# DATABASE_URL=postgresql://user:pass@host:5432/db

# =============================================================================
# OAuth Providers (Auto-detected)
# =============================================================================

# Xero
OAUTH_XERO_CLIENT_ID=your-xero-client-id
OAUTH_XERO_CLIENT_SECRET=your-xero-client-secret
OAUTH_XERO_ENVIRONMENT=production  # or 'sandbox'

# QuickBooks
OAUTH_QB_CLIENT_ID=your-quickbooks-client-id
OAUTH_QB_CLIENT_SECRET=your-quickbooks-client-secret
OAUTH_QB_ENVIRONMENT=production  # or 'sandbox'

# Gmail (optional)
# IMPORTANT: Use separate OAuth credentials for Gmail integration
# DO NOT reuse the same OAuth client used for Supabase login
# Setup: https://console.cloud.google.com → Enable Gmail API → OAuth 2.0 credentials
# Redirect URI: http://localhost:3336/api/oauth/gmail/callback
# Scopes: gmail.readonly, gmail.send
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret

# Outlook (optional)
# IMPORTANT: Use separate OAuth credentials for Outlook integration
# DO NOT reuse the same OAuth client used for Supabase login
# Setup: https://portal.azure.com → App registrations → Add API permissions (Mail.Read, Mail.Send, offline_access)
# Redirect URI: http://localhost:3336/api/oauth/outlook/callback
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret

# =============================================================================
# Application Settings
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3333  # Your app URL
