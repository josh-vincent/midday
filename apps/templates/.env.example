# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3335
NODE_ENV=development

# Database
# For PostgreSQL (production)
DATABASE_URL=postgresql://user:password@localhost:5432/midday_invoices

# For SQLite (development)
# DATABASE_URL=file:./dev.db

# Email Service (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=re_123456789
EMAIL_FROM=invoices@yourdomain.com

# File Storage (Vercel Blob or similar)
# For storing invoice PDFs and attachments
BLOB_READ_WRITE_TOKEN=vercel_blob_token_here
NEXT_PUBLIC_BLOB_URL=https://your-blob-storage.public.blob.vercel-storage.com

# Payment Integration (Stripe - Optional)
# For accepting invoice payments online
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PDF Generation
# Path to Chromium for PDF generation
PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/chromium
# Or use Browserless service
BROWSERLESS_API_KEY=your_browserless_key
BROWSERLESS_URL=https://chrome.browserless.io

# Security
# Secret for generating secure invoice tokens
INVOICE_TOKEN_SECRET=your-very-long-random-secret-key-here

# Optional: Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional: Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Optional: Authentication (if using Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: AI Features
OPENAI_API_KEY=sk-your-openai-api-key